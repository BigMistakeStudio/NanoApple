    "advice.large_canvas": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce grand format augmente fortement la mémoire et le temps de calcul. Essayez d’abord un format proche de 1024 px."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These large dimensions greatly increase memory use and processing time. Try dimensions around 1024 px first."
          }
        }
      }
    },
    "advice.slower_chip": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire suffisante, mais une puce Pro, Max ou Ultra est conseillée pour ce modèle. La génération peut être lente sur cette puce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory is sufficient, but a Pro, Max or Ultra chip is recommended for this model. Generation may be slow on this chip."
          }
        }
      }
    },
    "advice.hardware.summary": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
