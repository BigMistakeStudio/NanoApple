    "studio.prompt.enhanced.send.help": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie le texte dans l’instruction. La réécriture automatique et le style du préréglage sont désactivés pour utiliser exactement ce texte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies the text to the instruction. Automatic rewriting and preset styling are disabled to use this exact text."
          }
        }
      }
    },
    "studio.prompt.guide": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide du prompt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt guide"
          }
        }
      }
    },
    "studio.prompt.guide.character": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désignez l’image qui fixe l’identité du personnage. Décrivez séparément la nouvelle pose, la tenue et le décor ; réutilisez une référence validée pour chaque variante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identify the image that defines the character's identity. Describe the new pose, clothing and setting separately; reuse an approved reference for each variant."
          }
        }
      }
    },
    "studio.prompt.guide.character_reference": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une référence si l’identité doit rester la même d’une image à l’autre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a reference if the identity must stay the same from one image to the next."
          }
        }
      }
    },
    "studio.prompt.guide.compare": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour comparer deux prompts, gardez le même modèle, les mêmes dimensions, étapes, seed et références."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To compare two prompts, keep the same model, dimensions, steps, seed and references."
          }
        }
      }
    },
    "studio.prompt.guide.create": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez une image et une action précises : sujet, position, décor, cadrage et lumière. Pour une série, préparez une instruction par image."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a specific image and action: subject, position, setting, framing and lighting. For a series, prepare one instruction per image."
          }
        }
      }
    },
    "studio.prompt.guide.edit": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez d’abord ce qui change et le résultat attendu, puis ce qui doit rester identique. Évitez les consignes contradictoires."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First state what should change and the expected result, then what must stay the same. Avoid conflicting instructions."
          }
        }
      }
    },
    "studio.prompt.guide.missing_reference": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l’image à modifier avant de lancer ce mode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
