    "advice.unsupported_mac": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NanoApple demande un Mac Apple Silicon avec Metal et macOS 14 ou ultérieur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NanoApple requires an Apple Silicon Mac with Metal and macOS 14 or later."
          }
