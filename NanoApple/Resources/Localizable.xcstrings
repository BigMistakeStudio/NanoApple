    "studio.consistency_lora": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préserver le cadrage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserve framing"
          }
        }
      }
    },
    "studio.consistency_lora.help": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency LoRA réduit les déplacements et les retouches non demandées avec une seule image de référence. Pour un alignement précis, choisissez la taille de cette image. Elle peut empêcher un changement de pose ou de position. Testée surtout vers 1 Mpx avec des instructions en anglais et CFG 1 ; le prompt négatif est ignoré et le 2K n’a pas été validé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency LoRA reduces shifts and unwanted edits with a single reference image. For precise alignment, match the reference image dimensions. It may prevent changes in pose or position. Mostly tested around 1 MP with English instructions and CFG 1; the negative prompt is ignored and 2K has not been validated."
          }
        }
      }
    },
    "studio.consistency_lora.high_resolution": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette LoRA a surtout été testée vers 1 Mpx ; le résultat à cette taille est incertain."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This LoRA was mostly tested around 1 MP; results at this size are uncertain."
          }
        }
      }
    },
    "studio.consistency_lora.install_required": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Consistency LoRA dans Modèles pour utiliser cette option."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Consistency LoRA in Models to use this option."
          }
        }
      }
    },
    "studio.consistency_lora.match_reference": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
