    "studio.viggle_turbo.help": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée des images plus vite avec 6 étapes fixes. Le résultat peut être moins précis pour les retouches complexes ou les petits textes. Fonctionne avec le modèle Qwen complet, sans prompt négatif, et accepte jusqu’à 3 images de référence."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates images faster with 6 fixed steps. Results may be less precise for complex edits or small text. Works with the full Qwen model, without a negative prompt, and supports up to 3 reference images."
          }
        }
      }
    },
