    "advice.low_memory": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Go détectés ; %2$lld Go conseillés. Commencez à 768 px, fermez les autres applications ; ralentissements ou manque de mémoire possibles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld GB detected; %2$lld GB recommended. Start at 768 px and close other applications; slowdowns or insufficient memory are possible."
          }
        }
      }
    },
