    "studio.prompt.default": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photographie réaliste d’un renard roux assis au centre d’une clairière au lever du soleil. Il regarde vers l’objectif, la lumière dorée traverse les arbres et une légère brume adoucit l’arrière-plan. Fourrure détaillée, couleurs naturelles, cadrage à hauteur des yeux."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A realistic photograph of a red fox sitting in the center of a forest clearing at sunrise. It looks toward the camera, golden light passes through the trees and a light mist softens the background. Detailed fur, natural colors, eye-level framing."
          }
        }
      }
    },
